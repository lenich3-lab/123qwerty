# Copy to .env locally. Never commit real credentials.
# Use environment settings on the deployment host for production.
TUTOR_AI_API_KEY=
TUTOR_AI_MODEL=gpt-4.1-mini
# Required when HOST is public (0.0.0.0) or NODE_ENV=production. At least 12 characters.
TUTOR_AI_ACCESS_CODE=
HOST=127.0.0.1
PORT=8000
# Only needed when frontend is on a different origin, e.g. GitHub Pages.
# No trailing slash, no repository path. Separate multiple origins with commas.
TUTOR_AI_ALLOWED_ORIGINS=https://lenich3-lab.github.io
